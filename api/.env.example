# Configuracao da API e do PostgreSQL.
# POSTGRES_DB e POSTGRES_USER usam estes valores como exemplos e padrao local.
POSTGRES_DB=investeai
POSTGRES_USER=investeai
# O Spring usa "investeai" como fallback se nao for definido; troque por uma senha sua.
POSTGRES_PASSWORD=troque-esta-senha-local
# Obrigatorio: nao ha valor padrao. Use um segredo aleatorio de pelo menos 32 bytes.
JWT_SECRET=CHANGE_THIS_com_um_segredo_aleatorio_de_32_bytes
# Opcional; padrao vazio (integracao BRAPI desativada/limitada sem uma chave).
BRAPI_API_KEY=

# Opcoes opcionais da API (valores padrao):
# JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
# JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173
# RATE_LIMIT_RPM=60
# RATE_LIMIT_AUTH_RPM=10
# PORT=8080
# MAX_FILE_SIZE=2MB
# MAX_REQUEST_SIZE=3MB
# POSTGRES_HOST=localhost (no Compose, o host do banco e definido como "db")

# Overrides opcionais da conexao ao executar pelo Maven.
# Sem overrides, usa POSTGRES_HOST=localhost, POSTGRES_DB=investeai,
# POSTGRES_USER=investeai e POSTGRES_PASSWORD=investeai como padroes.
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/investeai
# SPRING_DATASOURCE_USERNAME=investeai
# SPRING_DATASOURCE_PASSWORD=investeai

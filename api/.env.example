# Use valores simples sem aspas e gere um segredo JWT aleatório.
POSTGRES_DB=investeai
POSTGRES_USER=investeai
POSTGRES_PASSWORD=troque-esta-senha-local
JWT_SECRET=CHANGE_THIS_com_um_segredo_aleatorio_de_32_bytes
BRAPI_API_KEY=

# Opções da API para Compose e Maven
# JWT_ACCESS_TOKEN_EXPIRATION_MS=900000
# JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000
# CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:3000,http://localhost:5173
# RATE_LIMIT_RPM=60
# RATE_LIMIT_AUTH_RPM=10

# Conexão opcional para executar pelo Maven

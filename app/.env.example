# URL base da API do InvesteAI que o app deve acessar.
# Navegador no computador ou simulador iOS: http://localhost:8080
# Emulador Android padrão: http://10.0.2.2:8080
# Celular físico: http://IP_DO_COMPUTADOR:8080 (use o IPv4 do computador na rede local)
# Valor padrao: http://localhost:8080 (navegador local/simulador iOS).
# Troque conforme o dispositivo. Use HTTP/HTTPS, sem barra final.
EXPO_PUBLIC_API_URL=http://localhost:8080

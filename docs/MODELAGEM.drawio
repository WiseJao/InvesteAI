        <mxCell id="note0" value="PK = chave primária   •   FK = chave estrangeira   •   UQ = único   •   ? = aceita NULL   •   [G] = coluna gerada" style="text;html=0;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacing=0;fontSize=12;fontColor=#000000;fontStyle=1;" parent="1" vertex="1">

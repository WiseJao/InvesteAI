        <mxCell id="note1" value="* O SQL admite vários questionários por perfil. O mapeamento JPA declara vínculo de um para um." style="text;html=0;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacing=0;fontSize=12;fontColor=#000000;fontStyle=0;" parent="1" vertex="1">

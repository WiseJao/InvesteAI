        <mxCell id="note2" value="As tabelas CDI são independentes. A aplicação usa a série histórica no cálculo, sem FK para posições." style="text;html=0;strokeColor=none;fillColor=none;verticalAlign=middle;align=left;spacing=0;fontSize=12;fontColor=#000000;fontStyle=0;" parent="1" vertex="1">
